{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ngeblogging",
  "main": "./cloudflare/worker-v37.mjs",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://ngeblogging.com",
    "PUBLIC_ALLOWED_ORIGINS": "https://ngeblogging.com,https://www.ngeblogging.com",
    "APP_RELEASE": "2026.07.24-studio-v14",
    "UI_V35_WORKER_COMPAT": "worker-v35.mjs",
    "UI_V35_RELEASE_COMPAT": "2026.07.25-studio-v35",
    "SUPABASE_URL": "https://polvmlrhqoiflumibfqs.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_Jqz6qDzX4IKSunPoDT5zyQ_sk6EK4W-",
    "QWEN_REGION": "singapore",
    "CF_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "CF_AI_FALLBACK_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "CF_AI_VISION_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "CF_AI_IMAGE_MODEL": "@cf/bytedance/stable-diffusion-xl-lightning",
    "NARA_FALLBACK_WORKER_COMPAT": "worker-v22.mjs",
    "UI_AUTHORITY_RELEASE": "2026.07.25-production-audit-v37",
    "PAYPAL_ENV": "sandbox",
    "PAYPAL_MERCHANT_EMAIL": "triapriyogibahari9@gmail.com",
    "AUTH_BRANDED_EMAIL_READY": "false",
    "AUTH_MEMBER_INVITES_READY": "false",
    "AUTH_EMAIL_FROM": "",
    "AUTH_EMAIL_DELIVERY_PROBE": "not-run",
    "NARA_PRODUCTION_READY": "true",
    "NARA_PRODUCTION_PROBE": "passed",
    "NARA_RUNTIME": "cloudflare-worker-production-v37"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
