    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_Jqz6qDzX4IKSunPoDT5zyQ_sk6EK4W-",
    "CUSTOM_DOMAIN_PROVIDER": "cloudflare-worker-custom-domain-v172",
    "PRODUCTION_ROUTE_AUTHORITY": "cloudflare-custom-domain-authority-v172",
    "PRODUCTION_CUSTOM_DOMAIN_RELEASE": "2026.07.30-production-custom-domain-v172",
    "CUSTOM_DOMAIN_DNS_V67": "false",
    "CLOUDFLARE_SAAS_ENABLED": "false",
    "CLOUDFLARE_CUSTOM_HOSTNAMES_READY": "false",
