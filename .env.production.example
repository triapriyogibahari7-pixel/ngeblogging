# Compose / Caddy (not secret)
GHCR_REPOSITORY_OWNER=triapriyogibahari7-pixel
IMAGE_TAG=latest
SITE_HOSTS=ngeblogging.com, www.ngeblogging.com
PRIMARY_SITE_DOMAIN=ngeblogging.com
ACME_EMAIL=admin@ngeblogging.com

# Public Supabase configuration. A publishable key is designed for browser use;
# RLS remains the actual database authorization boundary.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_PUBLIC_SITE_URL=https://ngeblogging.com
PUBLIC_SITE_URL=https://ngeblogging.com
PUBLIC_ALLOWED_ORIGINS=https://ngeblogging.com,https://www.ngeblogging.com

# Server-only Supabase key for verified billing writes. Never expose to Vite/browser.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Server-only Qwen / Model Studio configuration. Never commit real values.
QWEN_API_KEY=REPLACE_ME
QWEN_WORKSPACE_ID=REPLACE_ME
QWEN_REGION=singapore
QWEN_API_BASE_URL=
QWEN_MODEL=qwen3.6-flash
NARA_MODEL_MINI=qwen3.6-flash
NARA_MODEL_WRITER=qwen3.7-plus
NARA_MODEL_VISION=qwen3-vl-plus
NARA_MODEL_MAX=qwen3.7-max
NARA_IMAGE_MODEL=wan2.7-image
NARA_IMAGE_MODEL_PRO=wan2.7-image-pro

# PayPal remains sandbox until live merchant credentials and webhooks are verified.
PAYPAL_ENV=sandbox
PAYPAL_MERCHANT_EMAIL=triapriyogibahari9@gmail.com
PAYPAL_CLIENT_ID=REPLACE_ME
PAYPAL_CLIENT_SECRET=REPLACE_ME
PAYPAL_WEBHOOK_ID=REPLACE_ME

# QRIS / bank transfer requires a separately selected licensed Indonesian gateway.
LOCAL_PAYMENT_GATEWAY_URL=
LOCAL_PAYMENT_GATEWAY_SECRET=REPLACE_ME

# API runtime
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=1
MAX_REQUEST_BYTES=20971520
RATE_LIMIT_PER_MINUTE=20
NARA_RUNTIME=portable-api-v3
