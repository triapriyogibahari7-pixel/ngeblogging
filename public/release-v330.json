{
  "release": "studio-theme-code-device-v330-20260806",
  "date": "2026-08-06",
  "scope": "Make Theme HTML/CSS/JavaScript editor composition follow the selected Theme preview device instead of the browser layout viewport, including Chrome Android desktop-site mode.",
