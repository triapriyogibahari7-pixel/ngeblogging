    "LinkedIn OIDC",
    "GitHub OAuth",
    "email/password",
    "magic link",
    "email confirmation resend",
    "password recovery"
  ],
  "verificationLimits": {
    "providerEndToEndNeedsRealProviderCredentialsAndConsent": true,
    "capacityModelIsNotARealHundredsOfMillionsLoginLoadTest": true
  }
