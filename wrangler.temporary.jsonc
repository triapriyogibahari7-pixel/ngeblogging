{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ngeblogging-v11-audit",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://ngeblogging.com",
    "PUBLIC_ALLOWED_ORIGINS": "https://ngeblogging.com,https://www.ngeblogging.com",
    "SUPABASE_URL": "https://polvmlrhqoiflumibfqs.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_Jqz6qDzX4IKSunPoDT5zyQ_sk6EK4W-",
    "QWEN_REGION": "singapore",
    "PAYPAL_ENV": "sandbox",
    "PAYPAL_MERCHANT_EMAIL": "triapriyogibahari9@gmail.com",
    "AUTH_BRANDED_EMAIL_READY": "false",
    "AUTH_EMAIL_FROM": "",
    "AUTH_EMAIL_DELIVERY_PROBE": "not-run",
    "NARA_PRODUCTION_READY": "false",
    "NARA_PRODUCTION_PROBE": "temporary-ui-audit",
    "NARA_RUNTIME": "cloudflare-temporary-ui-audit-v11"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
