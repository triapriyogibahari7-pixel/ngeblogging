# Supabase (public browser configuration; injected only during the Vite build)
VITE_SUPABASE_URL=
# Recommended for new projects (safe to expose in the browser with RLS enabled)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only; never use service_role or secret keys in VITE_ variables
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=https://ngeblogging.com

# Cloudflare Worker secrets (server-only; set as encrypted Secrets, never commit values)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
QWEN_API_KEY=
QWEN_WORKSPACE_ID=

# Qwen / Alibaba Cloud Model Studio (Singapore is recommended for Indonesia)
QWEN_REGION=singapore
# Optional: only fill this when using another OpenAI-compatible Qwen endpoint.
# If empty, the Worker builds the Singapore URL automatically from QWEN_WORKSPACE_ID.
QWEN_API_BASE_URL=

# Optional model overrides. These defaults are already built into the runtime.
QWEN_MODEL=qwen3.6-flash
NARA_MODEL_MINI=qwen3.6-flash
NARA_MODEL_WRITER=qwen3.7-plus
NARA_MODEL_VISION=qwen3-vl-plus
NARA_MODEL_MAX=qwen3.7-max
PUBLIC_SITE_URL=https://ngeblogging.com
PUBLIC_ALLOWED_ORIGINS=https://ngeblogging.com,https://www.ngeblogging.com
NARA_RUNTIME=cloudflare-worker-v2

# Optional portable API runtime for local Docker/VPS disaster recovery only.
# TRUST_PROXY=1 is safe only when the API is reachable exclusively through a trusted proxy.
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=1
MAX_REQUEST_BYTES=20971520
RATE_LIMIT_PER_MINUTE=20
