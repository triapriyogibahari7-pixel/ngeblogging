# Supabase (public browser configuration)
VITE_SUPABASE_URL=
# Recommended for new projects (safe to expose in the browser with RLS enabled)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only; do not use service_role or secret keys in VITE_ variables
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=https://ngeblogging.com

# Server-only secrets: configure in Netlify, never prefix with VITE_
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
QWEN_API_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen3.5-4B
NARA_MODEL_MINI=Qwen/Qwen3.5-4B
NARA_MODEL_WRITER=
NARA_MODEL_VISION=
NARA_MODEL_MAX=
PUBLIC_SITE_URL=https://ngeblogging.com
