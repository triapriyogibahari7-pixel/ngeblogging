# Supabase public browser configuration (injected only during the Vite build)
VITE_SUPABASE_URL=
# Safe to expose in the browser when Row Level Security is enabled.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only. Never place service_role or secret keys in VITE_ variables.
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=https://ngeblogging.com

# Cloudflare Worker secrets (server-only; store as encrypted Cloudflare Secrets)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required for server-owned billing records and Cloudflare custom-domain reconciliation.
SUPABASE_SERVICE_ROLE_KEY=
QWEN_API_KEY=
QWEN_WORKSPACE_ID=

# Qwen / Alibaba Cloud Model Studio
QWEN_REGION=singapore
# Optional only when using a different OpenAI-compatible Qwen endpoint.
QWEN_API_BASE_URL=
QWEN_MODEL=qwen3.6-flash
NARA_MODEL_MINI=qwen3.6-flash
NARA_MODEL_WRITER=qwen3.7-plus
NARA_MODEL_VISION=qwen3-vl-plus
NARA_MODEL_MAX=qwen3.7-max
PUBLIC_SITE_URL=https://ngeblogging.com
PUBLIC_ALLOWED_ORIGINS=https://ngeblogging.com,https://www.ngeblogging.com
NARA_RUNTIME=cloudflare-worker-v3
# Never enable this in production. It exists only for isolated automated tests/local preview.
NARA_ALLOW_GUEST=false

# Cloudflare for SaaS custom hostnames (server-only)
# API token permission: SSL and Certificates Write for the ngeblogging.com zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Managed CNAME target shown to users, for example customers.ngeblogging.com.
CLOUDFLARE_CUSTOM_HOSTNAME_TARGET=
# Fallback/custom origin already present in the Ngeblogging zone.
CLOUDFLARE_CUSTOM_ORIGIN=ngeblogging.com

# PayPal production checkout. The UI remains hidden until all live values exist.
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_EMAIL=

# Optional licensed Indonesian payment gateway adapter.
LOCAL_PAYMENT_GATEWAY_URL=
LOCAL_PAYMENT_GATEWAY_SECRET=
# Example shape: {"pro_monthly":{"amount":79000,"currency":"IDR"}}
LOCAL_PLAN_PRICES_JSON={}

# Optional portable API runtime for local Docker/VPS disaster recovery only.
# TRUST_PROXY=1 is safe only when the API is reachable exclusively through a trusted proxy.
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=1
MAX_REQUEST_BYTES=20971520
RATE_LIMIT_PER_MINUTE=20
