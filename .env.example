# Supabase (public browser configuration)
VITE_SUPABASE_URL=
# Recommended for new projects (safe to expose in the browser with RLS enabled)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only; do not use service_role or secret keys in VITE_ variables
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=https://ngeblogging.com

# Server-only secrets: configure in Netlify, never prefix with VITE_
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Qwen / Alibaba Cloud Model Studio (recommended region for Indonesia: Singapore)
QWEN_API_KEY=
QWEN_WORKSPACE_ID=
QWEN_REGION=singapore
# Optional: only fill this when using another OpenAI-compatible Qwen endpoint.
# If empty, the server builds the Singapore URL automatically from QWEN_WORKSPACE_ID.
QWEN_API_BASE_URL=

# Optional model overrides. These official defaults are already built into the server.
QWEN_MODEL=qwen3.6-flash
NARA_MODEL_MINI=qwen3.6-flash
NARA_MODEL_WRITER=qwen3.7-plus
NARA_MODEL_VISION=qwen3-vl-plus
NARA_MODEL_MAX=qwen3.7-max
PUBLIC_SITE_URL=https://ngeblogging.com

# Portable API runtime (Docker/VPS). TRUST_PROXY=1 is safe only because the
# API container is reachable exclusively through the private Compose network.
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=1
MAX_REQUEST_BYTES=20971520
RATE_LIMIT_PER_MINUTE=20
NARA_RUNTIME=portable-api-v1
PUBLIC_ALLOWED_ORIGINS=https://ngeblogging.com,https://www.ngeblogging.com
