{
  "name": "ngeblogging",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/diagnose-tests-v147.mjs && vite build && node scripts/write-netlify-redirects.mjs",
    "preview": "vite preview",
    "start:api": "node api/server.mjs",
    "dev:cloudflare": "wrangler dev",
    "cloudflare:preview-dry-run": "wrangler versions upload --dry-run --outdir .wrangler-preview-build",
    "cloudflare:dry-run": "wrangler deploy --config wrangler.production.jsonc --dry-run --outdir .wrangler-build",
    "deploy:cloudflare": "wrangler deploy --config wrangler.production.jsonc --keep-vars",
    "domain:netlify": "node scripts/netlify-domain-alias.mjs",
    "check": "npm test && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:production": "node --test tests/*.test.mjs && node scripts/validate-production-v147.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.7",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "vite": "8.1.5",
    "wrangler": "4.113.0"
  }
}
